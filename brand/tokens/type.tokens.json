{
 "$description": "More typography. Two families from 205TF (licensed, self-hosted in the theme): Muoto for names and statements, Muoto Mono Condensed for the interface voice. Sizes are the ones the theme uses; nothing invented.",
 "$extensions": {
  "cstack": {
   "status": "PROVISIONAL",
   "source": "live site mymore.design, theme t/7 critical.css :root, captured 2026-10-15",
   "input_class": "live_brand_behavior",
   "approval": "awaiting More team"
  }
 },
 "font": {
  "family": {
   "$type": "fontFamily",
   "muoto": {
    "$value": [
     "Muoto",
     "DM Sans",
     "Helvetica Neue",
     "Arial",
     "sans-serif"
    ],
    "$description": "205TF Muoto Regular (weight 400; the theme also asks for 300 on long text). Product names, prices, statements, filters. Stand-in when the licensed file is not available: DM Sans (Google Fonts)."
   },
   "mono": {
    "$value": [
     "MuotoMono",
     "Martian Mono",
     "ui-monospace",
     "Menlo",
     "monospace"
    ],
    "$description": "205TF Muoto Mono Condensed Regular. Default body font of the theme: UI labels, buttons in [brackets], menu, footer. Stand-in: Martian Mono at width 75 (condensed), Google Fonts."
   }
  },
  "weight": {
   "$type": "fontWeight",
   "light": {
    "$value": 300
   },
   "regular": {
    "$value": 400
   },
   "semibold": {
    "$value": 600,
    "$description": "active filter only"
   }
  },
  "size": {
   "$type": "dimension",
   "caption": {
    "$value": {
     "value": 10,
     "unit": "px"
    },
    "$description": "thumbnail numbers 01 02 03, legal lines"
   },
   "label": {
    "$value": {
     "value": 11,
     "unit": "px"
    },
    "$description": "'Selecione a Madeira', announcement bar"
   },
   "body": {
    "$value": {
     "value": 13,
     "unit": "px"
    },
    "$description": "theme default (body), menu, buttons, prices"
   },
   "ui": {
    "$value": {
     "value": 15,
     "unit": "px"
    },
    "$description": "category filter, mobile menu"
   },
   "title": {
    "$value": {
     "value": 22,
     "unit": "px"
    },
    "$description": "product name on PDP"
   },
   "statement": {
    "$value": {
     "value": 26,
     "unit": "px"
    },
    "$description": "menu statement, line-height 1"
   },
   "about": {
    "$value": {
     "value": 32,
     "unit": "px"
    },
    "$description": "about block, line-height 1"
   },
   "display-3": {
    "$value": {
     "value": 48,
     "unit": "px"
    },
    "$description": "Display for print and screens wider than a phone: posters, invites, book, window. Never inside the shop UI. Line-height 0.95. Print: 48 pt.",
    "$extensions": {
     "cstack": {
      "status": "PROPOSED",
      "source": "critic panel 2026-10-15 (Bureau Borsche/Aparelho, Peclat, in-house designer lenses)",
      "approval": "awaiting More team"
     }
    }
   },
   "display-2": {
    "$value": {
     "value": 96,
     "unit": "px"
    },
    "$description": "Display: dates, piece names on posters and covers. Line-height 0.9, letter-spacing -0.02em. Print: 96 pt.",
    "$extensions": {
     "cstack": {
      "status": "PROPOSED",
      "source": "critic panel 2026-10-15 (Bureau Borsche/Aparelho, Peclat, in-house designer lenses)",
      "approval": "awaiting More team"
     }
    }
   },
   "display-1": {
    "$value": {
     "value": 240,
     "unit": "px"
    },
    "$description": "Display: one word or a date at wall/cover scale. Line-height 0.9. Print: 240 pt; on screen use clamp(96px, 20vw, 240px).",
    "$extensions": {
     "cstack": {
      "status": "PROPOSED",
      "source": "critic panel 2026-10-15 (Bureau Borsche/Aparelho, Peclat, in-house designer lenses)",
      "approval": "awaiting More team"
     }
    }
   }
  },
  "line-height": {
   "$type": "number",
   "tight": {
    "$value": 0.95,
    "$description": "mobile statement"
   },
   "solid": {
    "$value": 1
   },
   "ui": {
    "$value": 1.47,
    "$description": "22px on 15px"
   },
   "list": {
    "$value": 1.7,
    "$description": "menu product lists"
   }
  },
  "print-size": {
   "$type": "dimension",
   "$description": "Print scale in points (same ratios as web). Proposal from the in-house designer lens, to validate on the 205TF desktop licence.",
   "caption": {
    "$value": {
     "value": 6,
     "unit": "px"
    },
    "$description": "6 pt in print (legal, credits)"
   },
   "label": {
    "$value": {
     "value": 7,
     "unit": "px"
    },
    "$description": "7 pt in print (mono metadata; minimum for Mono Condensed on uncoated stock)"
   },
   "body": {
    "$value": {
     "value": 8.5,
     "unit": "px"
    },
    "$description": "8.5 pt in print (running text)"
   },
   "ui": {
    "$value": {
     "value": 10,
     "unit": "px"
    },
    "$description": "10 pt in print (names on tags and price lists)"
   },
   "title": {
    "$value": {
     "value": 14,
     "unit": "px"
    },
    "$description": "14 pt in print (piece name on spec sheets)"
   },
   "statement": {
    "$value": {
     "value": 20,
     "unit": "px"
    },
    "$description": "20 pt in print (short statements)"
   },
   "about": {
    "$value": {
     "value": 28,
     "unit": "px"
    },
    "$description": "28 pt in print (manifesto)"
   }
  }
 },
 "type": {
  "$type": "typography",
  "ui-mono": {
   "$value": {
    "fontFamily": "{font.family.mono}",
    "fontSize": "{font.size.body}",
    "fontWeight": 400,
    "lineHeight": 1.3,
    "letterSpacing": {
     "value": 0,
     "unit": "px"
    }
   },
   "$description": "[Voltar], Menu [+], Adicionar, footer"
  },
  "product-name": {
   "$value": {
    "fontFamily": "{font.family.muoto}",
    "fontSize": "{font.size.body}",
    "fontWeight": 400,
    "lineHeight": 1.3,
    "letterSpacing": {
     "value": 0,
     "unit": "px"
    }
   },
   "$description": "grid card name; price uses the same style in text.secondary"
  },
  "product-title": {
   "$value": {
    "fontFamily": "{font.family.muoto}",
    "fontSize": "{font.size.title}",
    "fontWeight": 400,
    "lineHeight": 1.1,
    "letterSpacing": {
     "value": 0,
     "unit": "px"
    }
   }
  },
  "statement": {
   "$value": {
    "fontFamily": "{font.family.muoto}",
    "fontSize": "{font.size.statement}",
    "fontWeight": 400,
    "lineHeight": 1,
    "letterSpacing": {
     "value": 0,
     "unit": "px"
    }
   }
  },
  "about": {
   "$value": {
    "fontFamily": "{font.family.muoto}",
    "fontSize": "{font.size.about}",
    "fontWeight": 400,
    "lineHeight": 1,
    "letterSpacing": {
     "value": 0,
     "unit": "px"
    }
   }
  },
  "label": {
   "$value": {
    "fontFamily": "{font.family.muoto}",
    "fontSize": "{font.size.label}",
    "fontWeight": 400,
    "lineHeight": 1.3,
    "letterSpacing": {
     "value": 0,
     "unit": "px"
    }
   }
  }
 }
}